rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /items/{itemId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'quantity', 'lowStockThreshold', 'costLots', 'salePriceCents', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.lowStockThreshold is int
        && request.resource.data.lowStockThreshold >= 0
        && request.resource.data.costLots is list
        && (!request.resource.data.keys().hasAny(['salePriceCents']) || request.resource.data.salePriceCents is int && request.resource.data.salePriceCents > 0);

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'lowStockThreshold', 'quantity', 'costLots', 'lastPurchaseCostCents', 'salePriceCents',
          'updatedAt', 'lastMovementId'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.lowStockThreshold is int
        && request.resource.data.lowStockThreshold >= 0
        && request.resource.data.costLots is list
        && (!request.resource.data.keys().hasAny(['lastPurchaseCostCents']) || request.resource.data.lastPurchaseCostCents is int)
        && (!request.resource.data.keys().hasAny(['salePriceCents']) || request.resource.data.salePriceCents is int)
        && (
          request.resource.data.quantity == resource.data.quantity
          || (
            request.resource.data.lastMovementId is string
            && getAfter(/databases/$(database)/documents/movements/$(request.resource.data.lastMovementId)).data.itemId == itemId
            && getAfter(/databases/$(database)/documents/movements/$(request.resource.data.lastMovementId)).data.after == request.resource.data.quantity
          )
        );

      allow delete: if signedIn() && resource.data.quantity == 0;
    }

    match /movements/{movementId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'itemId', 'itemName', 'kind', 'quantity', 'before', 'after',
          'note', 'uid', 'userEmail', 'createdAt', 'unitCostCents',
          'salePriceCents', 'totalRevenueCents', 'totalCostCents',
          'uncostedQuantity'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['entrada', 'saida']
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.before is int
        && request.resource.data.after is int
        && request.resource.data.after >= 0
        && request.resource.data.itemName is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.quantity == request.resource.data.before
        && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.quantity == request.resource.data.after
        && request.resource.data.totalCostCents is int
        && request.resource.data.totalCostCents >= 0
        && (
          (
            request.resource.data.kind == 'entrada'
            && request.resource.data.keys().hasAll(['unitCostCents', 'totalCostCents'])
            && request.resource.data.unitCostCents is int
            && request.resource.data.unitCostCents > 0
            && request.resource.data.totalCostCents == request.resource.data.unitCostCents * request.resource.data.quantity
            && request.resource.data.after == request.resource.data.before + request.resource.data.quantity
          )
          ||
          (
            request.resource.data.kind == 'saida'
            && request.resource.data.keys().hasAll(['salePriceCents', 'totalRevenueCents', 'totalCostCents', 'uncostedQuantity'])
            && request.resource.data.salePriceCents is int
            && request.resource.data.salePriceCents > 0
            && request.resource.data.totalRevenueCents == request.resource.data.salePriceCents * request.resource.data.quantity
            && request.resource.data.uncostedQuantity is int
            && request.resource.data.uncostedQuantity >= 0
            && request.resource.data.uncostedQuantity <= request.resource.data.quantity
            && request.resource.data.after == request.resource.data.before - request.resource.data.quantity
          )
        );
      allow update, delete: if false;
    }
  }
}
